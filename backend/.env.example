# Copy to backend/.env to override defaults. All values optional.
VIPER_HOST=127.0.0.1
VIPER_PORT=8000
# VIPER_DB_PATH=C:/path/to/viper.db
VIPER_DEFAULT_ENVIRONMENT=airport
VIPER_TICK_HZ=5
VIPER_SNAPSHOT_HZ=5
VIPER_CORRELATION_WINDOW_S=6
VIPER_HEARTBEAT_INTERVAL_S=2
VIPER_HEARTBEAT_TIMEOUT_S=7
VIPER_AMBIENT_EVENTS_PER_MIN=1.0
# 0 = random each run; any other integer makes the simulation repeatable
VIPER_RANDOM_SEED=0
VIPER_AUTOSTART=1
